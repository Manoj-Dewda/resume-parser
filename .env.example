GEMINI_API_KEY=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Max resume upload size in MB. Optional — defaults to 5 in api/main.py if unset.
MAX_RESUME_SIZE_MB=5
# Max queue-level claim attempts before a job is permanently failed, for
# failures that survive the worker's inline retry. Optional — defaults to 3
# in worker/run.py if unset.
MAX_ATTEMPTS=3
# Seconds a job can sit in 'processing' before it's assumed the worker died
# and becomes eligible for recovery. Must stay well above how long a real
# request can take — Gemini has no built-in request timeout. Optional —
# defaults to 600 (10 minutes) in worker/run.py if unset.
PROCESSING_TIMEOUT_SECONDS=600
# Number of worker poll loops to run concurrently (each with its own DB
# connection and Gemini client). Start low and measure — Gemini's free-tier
# rate limits and Supabase's connection limits are the real ceiling, not
# this number. Optional — defaults to 1 in worker/run.py if unset.
WORKER_CONCURRENCY=1
# Max size of the API's DB connection pool. Measured: a fresh connect() per
# request averaged ~1.8s vs ~0.26s reusing a connection, hence the pool —
# but keep this small, Supabase Free's connection limit is shared and
# scarce. Optional — defaults to 5 in api/main.py if unset.
API_DB_POOL_MAX_SIZE=5
